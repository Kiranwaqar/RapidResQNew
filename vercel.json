{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "build" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    }
    ,
    {
      "src": "/(.*)",
      "status": 302,
      "headers": { "Location": "https://rapid-res-qn-frontend.vercel.app/$1" }
    }
  ]
}
